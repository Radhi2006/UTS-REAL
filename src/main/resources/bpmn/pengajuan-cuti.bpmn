<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_PengajuanCuti"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="pengajuan-cuti" name="Pengajuan Cuti Karyawan" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="Start_Pengajuan" name="Karyawan mengajukan cuti">
      <bpmn:outgoing>Flow_ke_validasi</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Validasi" name="Validasi pengajuan" camunda:delegateExpression="${validasiCutiDelegate}">
      <bpmn:incoming>Flow_ke_validasi</bpmn:incoming>
      <bpmn:outgoing>Flow_ke_gateway_valid</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Valid" name="Data valid?">
      <bpmn:incoming>Flow_ke_gateway_valid</bpmn:incoming>
      <bpmn:outgoing>Flow_valid_ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_valid_tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Persetujuan" name="Persetujuan atasan" camunda:candidateGroups="camunda-admin">
      <bpmn:incoming>Flow_valid_ya</bpmn:incoming>
      <bpmn:outgoing>Flow_ke_gateway_setuju</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Setuju" name="Disetujui?">
      <bpmn:incoming>Flow_ke_gateway_setuju</bpmn:incoming>
      <bpmn:outgoing>Flow_setuju_ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_setuju_tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CatatDisetujui" name="Catat cuti disetujui" camunda:delegateExpression="${cutiDisetujuiDelegate}">
      <bpmn:incoming>Flow_setuju_ya</bpmn:incoming>
      <bpmn:outgoing>Flow_ke_end_disetujui</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CatatDitolak" name="Catat cuti ditolak" camunda:delegateExpression="${cutiDitolakDelegate}">
      <bpmn:incoming>Flow_valid_tidak</bpmn:incoming>
      <bpmn:incoming>Flow_setuju_tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_ke_end_ditolak</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Disetujui" name="Cuti disetujui">
      <bpmn:incoming>Flow_ke_end_disetujui</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Ditolak" name="Cuti ditolak">
      <bpmn:incoming>Flow_ke_end_ditolak</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ke_validasi" sourceRef="Start_Pengajuan" targetRef="Task_Validasi" />
    <bpmn:sequenceFlow id="Flow_ke_gateway_valid" sourceRef="Task_Validasi" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_valid_ya" name="ya" sourceRef="Gateway_Valid" targetRef="Task_Persetujuan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${valid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_valid_tidak" name="tidak" sourceRef="Gateway_Valid" targetRef="Task_CatatDitolak">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${!valid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ke_gateway_setuju" sourceRef="Task_Persetujuan" targetRef="Gateway_Setuju" />
    <bpmn:sequenceFlow id="Flow_setuju_ya" name="ya" sourceRef="Gateway_Setuju" targetRef="Task_CatatDisetujui">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${disetujui}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_setuju_tidak" name="tidak" sourceRef="Gateway_Setuju" targetRef="Task_CatatDitolak">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${!disetujui}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ke_end_disetujui" sourceRef="Task_CatatDisetujui" targetRef="End_Disetujui" />
    <bpmn:sequenceFlow id="Flow_ke_end_ditolak" sourceRef="Task_CatatDitolak" targetRef="End_Ditolak" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_PengajuanCuti">
    <bpmndi:BPMNPlane id="BPMNPlane_PengajuanCuti" bpmnElement="pengajuan-cuti">
      <bpmndi:BPMNShape id="Start_Pengajuan_di" bpmnElement="Start_Pengajuan">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="128" y="225" width="85" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validasi_di" bpmnElement="Task_Validasi">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="393" y="151" width="55" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Persetujuan_di" bpmnElement="Task_Persetujuan">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Setuju_di" bpmnElement="Gateway_Setuju" isMarkerVisible="true">
        <dc:Bounds x="655" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="656" y="151" width="49" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CatatDisetujui_di" bpmnElement="Task_CatatDisetujui">
        <dc:Bounds x="760" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CatatDitolak_di" bpmnElement="Task_CatatDitolak">
        <dc:Bounds x="760" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Disetujui_di" bpmnElement="End_Disetujui">
        <dc:Bounds x="922" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="907" y="225" width="66" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Ditolak_di" bpmnElement="End_Ditolak">
        <dc:Bounds x="922" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="912" y="365" width="57" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ke_validasi_di" bpmnElement="Flow_ke_validasi">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ke_gateway_valid_di" bpmnElement="Flow_ke_gateway_valid">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_valid_ya_di" bpmnElement="Flow_valid_ya">
        <di:waypoint x="445" y="200" />
        <di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="466" y="182" width="12" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_valid_tidak_di" bpmnElement="Flow_valid_tidak">
        <di:waypoint x="420" y="225" />
        <di:waypoint x="420" y="340" />
        <di:waypoint x="760" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="270" width="25" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ke_gateway_setuju_di" bpmnElement="Flow_ke_gateway_setuju">
        <di:waypoint x="600" y="200" />
        <di:waypoint x="655" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_setuju_ya_di" bpmnElement="Flow_setuju_ya">
        <di:waypoint x="705" y="200" />
        <di:waypoint x="760" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="726" y="182" width="12" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_setuju_tidak_di" bpmnElement="Flow_setuju_tidak">
        <di:waypoint x="680" y="225" />
        <di:waypoint x="680" y="270" />
        <di:waypoint x="810" y="270" />
        <di:waypoint x="810" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="688" y="245" width="25" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ke_end_disetujui_di" bpmnElement="Flow_ke_end_disetujui">
        <di:waypoint x="860" y="200" />
        <di:waypoint x="922" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ke_end_ditolak_di" bpmnElement="Flow_ke_end_ditolak">
        <di:waypoint x="860" y="340" />
        <di:waypoint x="922" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
